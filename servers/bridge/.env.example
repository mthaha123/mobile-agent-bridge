# Bridge Server 环境变量

# JWT 密钥（生产环境需改为强密码）
JWT_SECRET=dev-secret-change-in-production

# 可选的 Bridge 密码（不设置时允许免密登录）
# BRIDGE_PASSWORD=your-password-here

# Bridge 监听端口（默认 8080）
BRIDGE_PORT=8080

# OpenCode 服务地址（默认 http://localhost:4096）
OPENCODE_URL=http://localhost:4096

# 数据目录（注册表 projects.json 落盘位置，默认 <root>/servers/bridge/data）
# 生产可指向独立目录以与测试隔离
# BRIDGE_DATA_DIR=D:\srv\mab-data

# 项目 serve 端口池（逗号分隔，默认 4100-4104）
# 生产可换用独立端口段以与测试隔离
# BRIDGE_SERVE_PORT_POOL=4210,4211,4212,4213,4214
