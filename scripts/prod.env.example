# 生产环境配置模板（复制为 scripts/prod.env，该文件已被 .gitignore 排除）
#
# 用法:
#   node scripts/start-all.mjs --env-file scripts/prod.env
#   node scripts/start-all.mjs --env-file scripts/prod.env --status
#   node scripts/start-all.mjs --env-file scripts/prod.env --stop
#
# 目的：让生产实例在端口 / 数据 / 日志 / PID 上与开发测试实例完全隔离，
#       测试再折腾也碰不到生产的 8443 与项目 serve 端口池。

# ── 端口隔离（生产避开测试占用的 8080 / 4097 / 4100-4104）──
SERVE_PORT=4200
BRIDGE_PORT=8443
BRIDGE_SERVE_PORT_POOL=4210,4211,4212,4213,4214

# ── 数据 / 日志 / PID 隔离 ──
BRIDGE_DATA_DIR=D:\srv\mab-data
BRIDGE_LOG_DIR=D:\srv\mab-logs
BRIDGE_RUN_DIR=D:\srv\mab-run

# ── 生产运行编译产物（先在 servers/bridge 执行 npm run build）──
BRIDGE_ENTRY=D:\srv\mobile-agent-bridge\servers\bridge\dist\index.js
SERVE_CWD=D:\srv\mobile-agent-bridge

# ── 客户端密码（与 APK 内填写的保持一致；本次不调整）──
BRIDGE_PASSWORD=test123

# ── 可选：可执行文件路径覆盖 ──
# OPENCODE_EXE=C:\Users\<you>\AppData\Roaming\npm\node_modules\opencode-ai\bin\opencode.exe
# CLOUDFLARED_EXE=D:\srv\mobile-agent-bridge\scripts\tools\cloudflared.exe
