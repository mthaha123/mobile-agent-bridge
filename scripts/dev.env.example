# 开发环境隔离配置模板（复制为 scripts/dev.env，该文件已被 .gitignore 排除）
#
# 用法:
#   node scripts/start-all.mjs --env-file scripts/dev.env
#
# 端口段（见 scripts/ports.mjs）：
#   开发段 19985-19999 —— 与生产段 8080/4097/4100-4104 完全分离，
#   不会因"顺位使用"串到生产。混入生产端口会被 start-all 拒绝。
#   - bridge 19985：同时作为 E2E 真实链路测试桥（TEST_BRIDGE_PORT）
#   - serve 19986 / 项目池 19990-19999

SERVE_PORT=19986
BRIDGE_PORT=19985
BRIDGE_SERVE_PORT_POOL=19990,19991,19992,19993,19994,19995,19996,19997,19998,19999

BRIDGE_DATA_DIR=D:\code\mobile-agent-bridge\.dev-data
BRIDGE_LOG_DIR=D:\code\mobile-agent-bridge\logs\dev
BRIDGE_RUN_DIR=D:\code\mobile-agent-bridge\logs\dev

BRIDGE_PASSWORD=test123
SERVE_CWD=D:\code\mobile-agent-bridge

# 开发运行源码（tsx），不设 BRIDGE_ENTRY；生产才指向 dist/index.js
